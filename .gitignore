###############################################################################
# Node / Next.js project                                                      #
# Expanded ignore list suitable for GitHub deployment                         #
###############################################################################

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.bun/

# Build output
.next/
out/
dist/
build/
.turbo/
.swc/
.cache/

# Runtime data
*.pid
*.pid.lock
*.seed
pids/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Test coverage
coverage/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel / deployment
.vercel/

# OS / Editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
.history/

# SSL keys / certificates
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts
